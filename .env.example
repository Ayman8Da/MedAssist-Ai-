# ---------------------------------------------------------------------------
# MedAssist AI - environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Application
APP_NAME=MedAssist AI
APP_VERSION=0.1.0
APP_ENV=development            # development | test | production
API_PREFIX=/api
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Storage
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Application database (Phase 1 default: SQLite for local development)
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://medassist:medassist@localhost:5432/medassist
DATABASE_URL=

# Vector database (leave QDRANT_URL empty to use Qdrant local mode on disk)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COLLECTION=medassist_chunks

# Embeddings
EMBEDDING_PROVIDER=ollama        # ollama | openai | test (test = deterministic, tests only)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120

# Ollama (used by both embeddings and chat when selected)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible provider (optional). Works with OpenAI, OpenRouter, vLLM, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM
LLM_PROVIDER=ollama              # ollama | openai
LLM_MODEL=phi3:latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180

# Retrieval (traditional RAG baseline)
# CPU-only Ollama tip: a 12k-char context can exceed a 4k-token model window and
# makes prompt processing very slow. With phi3 on CPU use TOP_K=4,
# MAX_CONTEXT_CHARS=6000, LLM_MAX_TOKENS=600, LLM_TIMEOUT_SECONDS=600.
TOP_K=6
SCORE_THRESHOLD=
MAX_CONTEXT_CHARS=12000
RETRIEVAL_TIMEOUT_SECONDS=30

# Hybrid retrieval (Phase 2): BM25 + dense -> RRF -> optional reranker.
BM25_ENABLED=true
BM25_K1=1.5                    # term-frequency saturation
BM25_B=0.75                    # document-length normalisation
BM25_STEMMING=true             # Snowball English stemming (use false for exact terms)
RRF_K=60                       # standard Reciprocal Rank Fusion constant
DENSE_CANDIDATE_K=30           # dense candidates before fusion
KEYWORD_CANDIDATE_K=30         # BM25 candidates before fusion
RERANK_CANDIDATES=20           # fused candidates passed to the reranker
# "latest_versions_only" drops superseded documents. Version grouping is explicit:
# uploads that represent revisions of one document must share DOCUMENT_KEY.
LATEST_VERSIONS_ONLY=false

# Reranker: none | local | remote. "none" is explicit; it is never faked.
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8   # ~0.57 GB, downloaded on first use
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=8
RERANKER_TIMEOUT_SECONDS=120
# Shared cache folder for fastembed models (empty = fastembed default).
RERANKER_CACHE_DIR=./data/fastembed
# Only used when RERANKER_PROVIDER=remote (Cohere/Jina/OpenAI-compatible POST /rerank).
RERANKER_BASE_URL=
RERANKER_REMOTE_MODEL=
RERANKER_API_KEY=

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
